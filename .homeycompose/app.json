{
  "id": "com.dimapp.aaos",
  "version": "1.6.0",
  "compatibility": ">=12.0.0",
  "sdk": 3,
  "brandColor": "#3DDC84",
  "platforms": [
    "local"
  ],
  "name": {
    "en": "Android Automotive",
    "it": "Android Automotive"
  },
  "description": {
    "en": "Take your smart home on the road.",
    "it": "Porta la tua smart home in viaggio con te."
  },
  "author": {
    "name": "Simone Di Maio",
    "email": "simone.dimaio77@gmail.com"
  },
  "category": [
    "tools"
  ],
  "permissions": [
    "homey:manager:api",
    "homey:manager:geolocation"
  ],
  "images": {
    "small": "/assets/images/small.png",
    "large": "/assets/images/large.png",
    "xlarge": "/assets/images/xlarge.png"
  },
  "contributing": {
    "donate": {
      "paypal": {
        "username": "sdimaio77"
      }
    }
  },
  "homeyCommunityTopicId": 155279,
  "api": {
    "startAuth": {
      "method": "POST",
      "path": "/auth/start",
      "public": true
    },
    "pollAuth": {
      "method": "GET",
      "path": "/auth/poll",
      "public": true
    },
    "refreshAuth": {
      "method": "POST",
      "path": "/auth/refresh",
      "public": true
    },
    "getDashboards": {
      "method": "GET",
      "path": "/dashboards",
      "public": true
    },
    "getDevices": {
      "method": "GET",
      "path": "/devices"
    },
    "getZones": {
      "method": "GET",
      "path": "/zones"
    },
    "getLocation": {
      "method": "GET",
      "path": "/location",
      "public": true
    },
    "getGeofenceConfig": {
      "method": "GET",
      "path": "/geofence",
      "public": true
    },
    "postGeofenceEvent": {
      "method": "POST",
      "path": "/geofence/event",
      "public": true
    },
    "getThermometersConfig": {
      "method": "GET",
      "path": "/thermometers",
      "public": true
    },
    "getLogStatus": {
      "method": "GET",
      "path": "/log/status"
    },
    "getLogDownloadFile": {
      "method": "GET",
      "path": "/log/download/:index"
    },
    "deleteAllLogs": {
      "method": "DELETE",
      "path": "/log/all"
    },
    "deleteLogFile": {
      "method": "DELETE",
      "path": "/log/:index"
    }
  },
  "source": "https://github.com/s-dimaio/com.dimapp.aaos",
  "bugs": {
    "url": "https://github.com/s-dimaio/com.dimapp.aaos/issues"
  }
}